# ==============================================================================
# JM CREATIONS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Note: Variables starting with NEXT_PUBLIC_ are exposed to the browser.
# All other variables remain strictly server-side.
# ==============================================================================

# Public Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Public API (Database, Auth & Storage)
# Obtain from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Supabase Server-Side Secret Key (DO NOT EXPOSE TO BROWSER)
# Used in API routes to bypass RLS for administrative tasks & notifications
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# Resend Transactional Email Service
# Obtain from: https://resend.com/api-keys
# Official enquiry notification recipient: jmcreationinfo@gmail.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="JM Creations <notifications@jmcreations.in>"
NOTIFICATION_RECIPIENT_EMAIL=jmcreationinfo@gmail.com

# WhatsApp Cloud API / Meta for Developers
# Official WhatsApp contact: +91 90429 86355
# Obtain from: https://developers.facebook.com/apps/
WHATSAPP_ACCESS_TOKEN=EAAG...your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_RECIPIENT_NUMBER=919042986355

# Google Analytics 4
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin Panel Demo/Emergency Bypass (Optional development override)
# In production, authentication is strictly handled via Supabase Auth
ADMIN_DEFAULT_EMAIL=admin@jmcreations.com
